# Root .gitignore for Point of Sale monorepo

# Dependencies
node_modules/
.pnpm-store/

# Build outputs & caches
dist/
build/
*.tsbuildinfo
.vite/
.output/
.cache/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Temporary & Testing
coverage/
.nyc_output/
*.tmp
temp/

# Project Requitment Development
plan/
