# Point of Sale — Env template

### Create a .env file in the root folder of both the backend and frontend, using the format shown in the example below:
# Backend .env
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=<API-KEY:ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
SUPABASE_JWT_SECRET=<JWT_KEYS_SECRET>
CORS_ORIGINS=<URL_ACCESS_BACKEND: https://fe.example.com,http://localhost:5173,http://localhost:4000>
PORT=4000

# Frontend .env
VITE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<API-KEY:ANON_KEY>
VITE_API_BASE_URL=http://localhost:4000/api/v1