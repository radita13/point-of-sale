# Point of Sale — Env template
# Buat project Supabase, lalu isi nilai nyata di .env lokal tiap app (apps/backend/.env).

# === Backend (Express + Prisma) — apps/backend ===
# Prisma runtime: Supabase SESSION pooler (port 5432)
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# Prisma migrate deploy: Supabase DIRECT connection
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Backend port
PORT=4000

# Origin CORS yang diizinkan (koma-terpisah). Default: origin dev Vite.
# Untuk produksi set ke origin PWA, mis. CORS_ORIGINS=https://pos.anda.com
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Supabase (FE auth & BE verification) ===
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# FE anon key (public)
SUPABASE_ANON_KEY=<ANON_KEY>
# BE service role key (bypass RLS) — JANGAN bocor ke FE
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
# For verifying Supabase JWT in Express middleware
SUPABASE_JWT_SECRET=<JWT_SECRET>
# (Alternative) JWKS URL if using signing keys:
# SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/jwks.json

# === Backend API base (used by FE api client) ===
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY live in apps/frontend/.env
VITE_API_BASE_URL=http://localhost:4000/api/v1