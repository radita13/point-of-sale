generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  ownerId              String?               @db.Uuid
  createdAt            DateTime              @default(now())
  products             Product[]
  transactions         Transaction[]
  inventoryAdjustments InventoryAdjustment[]
}

model Product {
  id               String                @id @default(uuid()) @db.Uuid
  serverId         String                @unique @db.Uuid
  sku              String                @unique
  name             String
  category         String
  costPrice        Decimal               @db.Decimal(12, 2)
  sellingPrice     Decimal               @db.Decimal(12, 2)
  stock            Float
  minStock         Float
  unit             String
  step             Float?
  piecesPerUnit    Int?
  smallUnit        String?
  smallPrice       Decimal?              @db.Decimal(12, 2)
  image            String?
  isDeleted        Boolean               @default(false)
  updatedAt        DateTime              @default(now()) @updatedAt
  storeId          String                @db.Uuid
  store            Store                 @relation(fields: [storeId], references: [id])
  transactionItems TransactionItem[]
  adjustments      InventoryAdjustment[]

  @@index([sku])
  @@index([storeId])
  @@map("products")
}

model Transaction {
  id            String            @id @db.Uuid
  invoiceNo     String
  timestamp     DateTime
  totalAmount   Decimal           @db.Decimal(14, 2)
  finalAmount   Decimal           @db.Decimal(14, 2)
  paymentMethod String
  payAmount     Decimal           @db.Decimal(14, 2)
  changeAmount  Decimal           @db.Decimal(14, 2)
  storeId       String            @db.Uuid
  store         Store             @relation(fields: [storeId], references: [id])
  items         TransactionItem[]

  @@unique([invoiceNo, storeId])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id])
  productName   String
  sku           String?
  qty           Float
  unit          String
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal?    @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(14, 2)

  @@index([transactionId])
  @@map("transaction_items")
}

model InventoryAdjustment {
  id         String   @id @db.Uuid // local UUID v4
  storeId    String   @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id])
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  note       String?
  adjustedAt DateTime

  @@index([storeId])
  @@map("inventory_adjustments")
}
