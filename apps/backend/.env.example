// Supabase connection strings (isi dari Project Settings -> Database)
// DATABASE_URL  : koneksi runtime Prisma — gunakan SESSION pooler port 5432
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
// DIRECT_URL    : koneksi direct (untuk `prisma migrate deploy`), port 5432 non-pooler
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

// Supabase Auth (untuk verifikasi JWT)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET=""
// Service role key (untuk upload foto produk ke Supabase Storage) — AMAN di sisi
// backend saja, JANGAN dibocorkan ke frontend/anon.
SUPABASE_SERVICE_ROLE_KEY=""

PORT=4000